# Copy to an ignored .env file and fill required blanks before starting.
# DO NOT give this file to engine containers: it contains server-only secrets.
DCACHE_LISTEN=:8080
DCACHE_DB=/state/cache.db
DCACHE_POOL=shared
DCACHE_TOKEN=
DCACHE_HMAC_SECRET=
DCACHE_ENGINE_VERSION=v1.0.0-beta.25
DCACHE_URL_TTL=15m
DCACHE_CHECKPOINT_INTERVAL=10m
S3_ENDPOINT=http://objectstore:9000
S3_PUBLIC_ENDPOINT=http://objectstore:9000
S3_BUCKET=dagger-cache
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
